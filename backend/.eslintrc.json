{
  "parser": "@typescript-eslint/parser",
  "extends": [
    "airbnb-base",
    "plugin:@typescript-eslint/recommended"
  ],
  "plugins": ["@typescript-eslint"],
  "env": {
    "node": true,
    "es2020": true,
    "jest": true
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", {
      "ts": "never"
    }],
    "no-console": "off",
    "@typescript-eslint/no-unused-vars": ["error"],
    "import/no-unresolved": "off"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".ts", ".js"]
      }
    }
  }
}